<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.duo</groupId>
    <artifactId>duo-harness</artifactId>
    <version>1.1.0</version>
  </parent>

  <artifactId>duo-harness-stats</artifactId>
  <description>工具统计插件（M27 demo，ADR-0029）：第三方插件形态范例——监听工具执行计数、/toolstats 命令与 tool_stats 查询工具，零内核改动接入</description>

  <dependencies>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- commands 服务（CommandsRegistry/CommandDefinition）在 agent 域 -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
  </dependencies>

  <!-- 插件包交货形态（M35 工单 07，ADR-0037）：v1 = 常规 `mvn package` 产物——
       模块 jar 只含自有类，宿主 API 与公共库（jackson/slf4j 等）由宿主 classpath
       供给（自优先加载器约定：插件包不得打入宿主供给的类，实测会撞加载器约束）。
       需要自带宿主没有的独有库的作者，自行 shade 并逐件排除宿主供给面（交货文档
       于 M35 工单 08 落文档站）。 -->
</project>
