<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.duo</groupId>
    <artifactId>duo-harness</artifactId>
    <version>1.3.0</version>
  </parent>

  <artifactId>duo-harness-example</artifactId>
  <description>示例插件与 Demo 入口：一条命令演示 M1 全部机制（服务注入/工具管线/禁用行/状态迁移）</description>

  <dependencies>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-cli</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-hooks</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-tools</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- demo 是聚合点：M2 段落演示 MCP 连接（MiniFileSystemServer + McpClientPlugin） -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M3 段落演示 LLM 对话（ChatReplMain） -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-llm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M4 段落演示会话记忆（多轮上下文 + 自动继续） -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-session</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 会话检索插件（M21 工单 08，ADR-0022）：agent-demo.yml 的 session-query 行 -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-session-query</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M5 段落演示 agent 工具循环（ChatAgent Function Calling） -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M27 demo：工具统计插件（第三方插件形态范例，ADR-0029）——接入行之一 -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-stats</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M35：插件中心（生态管理面，ADR-0037）——接入行之一（opt-in 装配） -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-plugin-center</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- M36：亮色主题样板（ADR-0038 决策二）——第三方主题的官方示范接入行（opt-in 装配） -->
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-theme-light</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <!-- runtime：Demo 运行期要有 SLF4J binding（内核的 warn/info 叙述才可见） -->
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <properties>
    <!-- 本模块启用 exec:java（Demo 验收命令的载体）；演示入口经 -Dexec.mainClass 切换 -->
    <exec.skip>false</exec.skip>
  </properties>

  <build>
    <!-- 对外产物名去 example 后缀（M30 工单 02）：duo-harness-<version>.jar，
         版本随 ${project.version} 走——发版收口期 pom 对齐 0.26.0 后产物名即同步 -->
    <finalName>duo-harness-${project.version}</finalName>
    <plugins>
      <!-- shade fat-jar（ADR-0029 发布产物，M30 工单 02）：java -jar 即跑，
           入口 DuoMain（缺省装配 agent-demo.yml 经 Boot.fromResource 从 jar 内装载）。
           非发布链路的演示入口仍走 exec:java，不受产物名变化影响。
           3.6.1 = 发版时点 shade 最新 stable（nexus 已核实），首个支持 Maven 4 的线。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- 应用自用 fat-jar，非待发布构件：不生成 dependency-reduced-pom -->
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>dev.duo.harness.example.DuoMain</mainClass>
                </transformer>
                <!-- META-INF/services 合并：多 jar 同名 SPI 声明（jackson ObjectCodec/JsonFactory、
                     imageio ImageReaderSpi、sqlite Driver、slf4j ServiceProvider 实测在册）
                     合 jar 时只留一份即断链，transformer 逐组合并 -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <!-- 签名文件排除系 shade 惯例的预防性处理（ADR-0032 裁定兜底；当前依赖集
                         实测零签名 jar，防的是未来传递依赖引入签名后类加载 SecurityException） -->
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <!-- module-info：多依赖重复冲突且类路径形态无模块化诉求 -->
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
