<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.duo</groupId>
    <artifactId>duo-harness</artifactId>
    <version>0.18.0</version>
  </parent>

  <artifactId>duo-harness-attachment</artifactId>
  <description>附件域：内容寻址图片库（SHA-256 硬链接去重、规范化、永不自动删除）</description>

  <dependencies>
    <dependency>
      <groupId>dev.duo</groupId>
      <artifactId>duo-harness-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 图片解码规范化（M21，ADR-0022）：TwelveMonkeys 补 WebP 解码与强 JPEG，Thumbnailator 缩放；均纯 Java -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
    </dependency>
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>
  </dependencies>
</project>
